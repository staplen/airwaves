# Copy to /share/airwaves/airwaves.env on the Pi and fill in the password.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=airwaves
MQTT_PASS=change-me
# Optional: your own gas meter's ERT id, to call it out in the feed.
GAS_METER_ID=
# HD Radio stations to rotate through, space-separated "MHz:program" (program 0 = HD1, 1 = HD2).
# Fill in the HD stations you can receive locally, e.g. "97.1:0 88.5:1". Empty = skip the slot.
HD_STATIONS=
# Receiver location, used only on the Pi for readsb distance/position decoding. Never commit real values.
HOME_LAT=
HOME_LON=
