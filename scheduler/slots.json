{
  "comment": "One dongle, rotating. Host paths are Home Assistant OS paths: /share = /mnt/data/supervisor/share, /media = /mnt/data/supervisor/media. ${VAR} comes from the scheduler's environment (airwaves.env); a --flag whose value is empty is dropped. ${TS} is a UTC timestamp. Times in windows are local (TIMEZONE). Images are pinned to tested versions.",
  "standby": "ultrafeeder",
  "slots": [
    {
      "id": "adsb", "name": "ADS-B", "freqMhz": 1090, "minutes": 1,
      "image": "ghcr.io/sdr-enthusiasts/docker-adsb-ultrafeeder:latest-build-845",
      "entrypoint": ["readsb"],
      "cmd": ["--device-type", "rtlsdr", "--device", "0", "--gain", "49.6",
              "--lat", "${HOME_LAT}", "--lon", "${HOME_LON}",
              "--write-json", "/out", "--write-json-every", "1", "--quiet",
              "--db-file=/usr/local/share/tar1090/aircraft.csv.gz", "--db-file-lt"],
      "binds": ["/mnt/data/supervisor/share/airwaves/readsb:/out"]
    },
    {
      "id": "atc", "name": "ATC", "freqMhz": 119.55, "minutes": 0.5,
      "image": "ghcr.io/rtl-airband/rtlsdr-airband:v7.0.1",
      "binds": [
        "/mnt/data/supervisor/share/airwaves/app/deploy/atc/rtl_airband.conf:/app/rtl_airband.conf:ro",
        "/mnt/data/supervisor/media/airwaves/atc:/recordings"
      ]
    },
    {
      "id": "ais", "name": "Ships", "freqMhz": 162.0, "minutes": 0.5,
      "image": "ghcr.io/jvde-github/ais-catcher:v0.71",
      "cmd": ["-u", "127.0.0.1", "4100"]
    },
    {
      "id": "vdl2", "name": "Datalink", "freqMhz": 136.8, "minutes": 1,
      "image": "ghcr.io/sdr-enthusiasts/docker-dumpvdl2:latest-build-443",
      "entrypoint": ["dumpvdl2"],
      "cmd": ["--rtlsdr", "0", "--gain", "44.5", "--correction", "0",
              "--output", "decoded:json:udp:address=127.0.0.1,port=4101",
              "136650000", "136700000", "136725000", "136775000", "136800000", "136825000", "136875000", "136975000"]
    },
    {
      "id": "ism", "name": "Sensors", "freqMhz": 433.92, "minutes": 2,
      "image": "hertzg/rtl_433:25.12",
      "comment": "433.92 is listed twice: 80 s for the neighbour's LaCrosse thermometer (reports about once a minute), then 40 s of 315 MHz tire sensors. 915 MHz meters dropped: none heard in the first 70 hours.",
      "cmd": ["-f", "433.92M", "-f", "433.92M", "-f", "315M", "-H", "40",
              "-F", "mqtt://127.0.0.1:1883,user=${MQTT_USER},pass=${MQTT_PASS},retain=0,events=airwaves/rtl_433"]
    },
    {
      "id": "trains", "name": "Trains", "freqMhz": 457.9375, "minutes": 1,
      "comment": "End-of-train devices: raw 12 kHz FM audio; the collector keeps any 1200-baud bursts in trains/review/. 1 minute by day: every burst so far came at night.",
      "windows": [{ "start": "06:00", "end": "20:00" }],
      "image": "ghcr.io/sdr-enthusiasts/docker-adsb-ultrafeeder:latest-build-845",
      "entrypoint": ["rtl_fm"],
      "cmd": ["-f", "457.9375M", "-M", "fm", "-s", "12k", "-g", "44.5", "/out/eot_${TS}.raw"],
      "binds": ["/mnt/data/supervisor/share/airwaves/trains:/out"]
    },
    {
      "id": "trains", "name": "Trains (night)", "freqMhz": 457.9375, "minutes": 3,
      "comment": "3 minutes at night, when freight runs and all bursts so far were heard.",
      "windows": [{ "start": "20:00", "end": "24:00" }, { "start": "00:00", "end": "06:00" }],
      "image": "ghcr.io/sdr-enthusiasts/docker-adsb-ultrafeeder:latest-build-845",
      "entrypoint": ["rtl_fm"],
      "cmd": ["-f", "457.9375M", "-M", "fm", "-s", "12k", "-g", "44.5", "/out/eot_${TS}.raw"],
      "binds": ["/mnt/data/supervisor/share/airwaves/trains:/out"]
    },
    {
      "id": "noaa", "name": "NOAA", "freqMhz": 162.45, "minutes": 1,
      "image": "airwaves-noaa:local",
      "binds": ["/mnt/data/supervisor/media/airwaves/noaa:/out"],
      "env": ["MQTT_USER=${MQTT_USER}", "MQTT_PASS=${MQTT_PASS}"]
    },
    {
      "id": "noaa", "name": "NOAA weekly test", "freqMhz": 162.45, "minutes": 6,
      "comment": "Extra NOAA time Wednesday late morning, when the required weekly test usually airs.",
      "windows": [{ "days": [3], "start": "10:45", "end": "12:15" }],
      "image": "airwaves-noaa:local",
      "binds": ["/mnt/data/supervisor/media/airwaves/noaa:/out"],
      "env": ["MQTT_USER=${MQTT_USER}", "MQTT_PASS=${MQTT_PASS}"]
    },
    {
      "id": "sonde", "name": "Weather balloon", "freqMhz": 403, "minutes": 8,
      "comment": "Twice-daily NWS launches (about 6 AM / 6 PM Eastern) and their ~2-hour flights.",
      "windows": [{ "start": "05:45", "end": "08:30" }, { "start": "17:45", "end": "20:30" }],
      "image": "ghcr.io/projecthorus/radiosonde_auto_rx:v1.9.0",
      "binds": [
        "/mnt/data/supervisor/share/airwaves/sonde/station.cfg:/opt/auto_rx/station.cfg:ro",
        "/mnt/data/supervisor/share/airwaves/sonde/log:/opt/auto_rx/log"
      ]
    },
    {
      "id": "hdradio", "name": "HD Radio", "freqMhz": 98, "minutes": 3, "runsOnce": true,
      "comment": "3 minutes: the sweep alone (up to 20 s per station), no dwell.",
      "image": "airwaves-hdradio:local",
      "binds": ["/mnt/data/supervisor/share/airwaves/hdradio:/out"],
      "env": ["HD_STATIONS=${HD_STATIONS}", "HD_SNIPPET_SEC=12", "HD_SWEEP_MAX_SEC=20", "HD_DWELL_SEC=0"]
    },
    {
      "id": "hdradio", "name": "HD Radio (deep)", "freqMhz": 99.5, "minutes": 4.5, "runsOnce": true, "everyLoops": 3,
      "comment": "Every 3rd loop: a quick pass over the three stations that broadcast traffic/radar image maps, then 3 minutes on one of them (rotating every 20 min) so the whole traffic map, radar and album art come through.",
      "image": "airwaves-hdradio:local",
      "binds": ["/mnt/data/supervisor/share/airwaves/hdradio:/out"],
      "env": ["HD_STATIONS=98.7:0 99.5:0 101.1:0", "HD_SNIPPET_SEC=12", "HD_SWEEP_MAX_SEC=20", "HD_DWELL_SEC=180"]
    },
    {
      "id": "spectrum", "name": "Spectrum", "freqMhz": 500, "minutes": 1, "everyMinutes": 60,
      "runsOnce": true,
      "image": "ghcr.io/sdr-enthusiasts/docker-adsb-ultrafeeder:latest-build-845",
      "entrypoint": ["rtl_power"],
      "cmd": ["-f", "88M:1100M:250k", "-g", "44.5", "-i", "15", "-1", "/out/spectrum_${TS}.csv"],
      "binds": ["/mnt/data/supervisor/share/airwaves/spectrum:/out"]
    }
  ]
}
